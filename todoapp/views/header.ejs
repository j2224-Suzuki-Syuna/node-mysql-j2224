<head>
    <title><%= title %></title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.2.1/css/bootstrap.min.css">
    
    <link rel="stylesheet" href="/stylesheets/retro-rpg-theme.css">

    <style> /* ページ固有のスタイルがあればここに残す */ </style>
</head>
<nav class="navbar navbar-expand-lg navbar-light bg-light">
  <a class="navbar-brand" href="/">TodoApp</a>
  <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav"
          aria-expanded="false" aria-label="Toggle navigation">
    <span class="navbar-toggler-icon"></span>
  </button>
  <div class="collapse navbar-collapse" id="navbarNav">
    <ul class="navbar-nav mr-auto">
      <% if(isAuth){ %>
        <li class="nav-item">
          <a class="nav-link" href="/calendar">カテゴリ管理</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/profile">プロフィール</a>
        </li>
      <% } %>
    </ul>

    <ul class="navbar-nav">
      <% if(isAuth && user && typeof user.level !== 'undefined' && typeof user.points !== 'undefined'){ %>
        <% const requiredPoints = user.level * 50; %>
        <% const progress = requiredPoints > 0 ? (user.points / requiredPoints) * 100 : 0; %>
        
        <li class="nav-item d-flex align-items-center mr-3">
            <span class="mr-2"><strong>Lv. <%= user.level %></strong></span>
            <div class="progress" style="width: 100px;" title="<%= user.points %> / <%= requiredPoints %>">
                <div class="progress-bar" role="progressbar" style="width: <%= progress %>%;" aria-valuenow="<%= user.points %>" aria-valuemin="0" aria-valuemax="<%= requiredPoints %>"></div>
            </div>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/logout">Logout (<%= user.name %>)</a>
        </li>

      <% } else if (isAuth) { %>
        <li class="nav-item">
            <a class="nav-link" href="/logout">Logout</a>
        </li>
      <% } else { %>
        <li class="nav-item">
          <a class="nav-link" href="/signin">Sign in</a>
        </li>
      <% } %>
    </ul>
  </div>
</nav>